generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(uuid()) @db.Uuid
  wechatOpenId String           @unique @map("wechat_open_id")
  nickname     String?
  avatarFileId String?          @db.Uuid @map("avatar_file_id")
  phoneCountryCode String?      @map("phone_country_code")
  phoneNumber      String?      @map("phone_number")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  sessions     RefreshSession[]
  uploads      UploadIntent[]

  @@map("users")
}

enum UploadStatus {
  PENDING
  READY
}

model UploadIntent {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid @map("user_id")
  objectKey    String       @unique @map("object_key")
  contentType  String       @map("content_type")
  expectedSize Int          @map("expected_size")
  expiresAt    DateTime     @map("expires_at")
  status       UploadStatus @default(PENDING)
  confirmedAt  DateTime?    @map("confirmed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("upload_intents")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}
