# Copy to docker/local/.env.local. Keep this file private.
APP_ENV_FILE=docker/local/.env.local
COMPOSE_PROJECT_NAME=custom_wechat_app
API_IMAGE=docker.io/example/custom-wechat-api:replace-with-tag
API_PORT=3100
# PostgreSQL runs on the server host; use host.docker.internal, not localhost.
# Example: postgresql://app_user:URL_ENCODED_PASSWORD@host.docker.internal:5432/app_db
DATABASE_URL=postgresql://template:localdev@host.docker.internal:5433/template

JWT_SECRET=replace-with-a-separate-local-random-secret
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_APP_SECRET=replace-with-wechat-app-secret
OSS_REGION=cn-hangzhou
OSS_BUCKET=replace-with-private-bucket
OSS_ENDPOINT=https://replace-with-private-bucket.oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret

# Leave the merchant ID empty until the HTTPS proxy and callbacks are reachable.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL=replace-with-merchant-certificate-serial
WECHAT_PAY_MERCHANT_PRIVATE_KEY=replace-with-pem-private-key
WECHAT_PAY_API_V3_KEY=replace-with-32-byte-api-v3-key
WECHAT_PAY_PUBLIC_KEY_ID=replace-with-wechat-pay-public-key-id
WECHAT_PAY_PUBLIC_KEY=replace-with-wechat-pay-public-key-pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/payments/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://api.example.com/payments/wechat/refund-notify
DEMO_PAYMENTS_ENABLED=false

# Register real HTTPS WebView applications when available.
WEBVIEW_APPS_JSON=[]
